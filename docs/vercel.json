{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/proxy.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/voice-ticket",
      "destination": "/api/proxy?route=voice-ticket"
    },
    {
      "destination": "/api/proxy?route=session",
      "source": "/api/session"
    },
    {
      "destination": "/api/proxy?route=chat",
      "source": "/api/chat"
    },
    {
      "destination": "/api/proxy?route=emotion",
      "source": "/api/emotion"
    },
    {
      "destination": "/api/proxy?route=story",
      "source": "/api/story"
    },
    {
      "destination": "/api/proxy?route=health",
      "source": "/api/health"
    },
    {
      "destination": "/:path*",
      "source": "/qqmusic/:path*"
    }
  ]
}
